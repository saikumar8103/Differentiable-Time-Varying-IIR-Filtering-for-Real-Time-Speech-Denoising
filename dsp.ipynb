import torch
import torch.nn as nn
import torch.nn.functional as F


class TimeVaryingIIR(nn.Module):
    def __init__(self, order=2):
        super(TimeVaryingIIR, self).__init__()
        self.order = order

        # Feedforward coefficients (b)
        self.b_net = nn.Sequential(
            nn.Linear(1, 32),
            nn.ReLU(),
            nn.Linear(32, order + 1)
        )

        # Feedback coefficients (a)
        self.a_net = nn.Sequential(
            nn.Linear(1, 32),
            nn.ReLU(),
            nn.Linear(32, order)
        )

    def forward(self, x):
        """
        x: (batch, time)
        """
        B, T = x.shape
        y = torch.zeros_like(x)

        # Initialize past outputs
        y_past = torch.zeros(B, self.order, device=x.device)
        x_past = torch.zeros(B, self.order, device=x.device)

        for t in range(T):
            t_norm = torch.tensor([[t / T]], dtype=x.dtype, device=x.device).repeat(B, 1)

            b = self.b_net(t_norm)              # (B, order+1)
            a = self.a_net(t_norm)              # (B, order)

            # Current input
            x_t = x[:, t].unsqueeze(1)

            # Feedforward part
            ff = b[:, 0:1] * x_t
            for i in range(self.order):
                ff += b[:, i + 1:i + 2] * x_past[:, i:i + 1]

            # Feedback part
            fb = 0
            for i in range(self.order):
                fb += a[:, i:i + 1] * y_past[:, i:i + 1]

            y_t = ff - fb

            # Save output
            y[:, t] = y_t.squeeze(1)

            # Update states
            x_past = torch.cat([x_t, x_past[:, :-1]], dim=1)
            y_past = torch.cat([y_t, y_past[:, :-1]], dim=1)

        return y


class SpeechDenoiser(nn.Module):
    def __init__(self, order=2):
        super(SpeechDenoiser, self).__init__()
        self.iir = TimeVaryingIIR(order)

    def forward(self, noisy_signal):
        return self.iir(noisy_signal)


# Example usage
if __name__ == "__main__":
    batch_size = 2
    time_steps = 16000  # 1 sec audio @16kHz

    noisy = torch.randn(batch_size, time_steps)

    model = SpeechDenoiser(order=2)
    clean_est = model(noisy)

    print(clean_est.shape)
