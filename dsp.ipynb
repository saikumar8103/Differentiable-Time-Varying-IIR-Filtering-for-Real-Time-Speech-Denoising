# Differentiable Time-Varying IIR Filtering for Real-Time Speech Denoising

import torch
import torch.nn as nn
import torch.optim as optim
import matplotlib.pyplot as plt


# =========================
# Model Definition
# =========================
class TimeVaryingIIR(nn.Module):
    def __init__(self, order=2):
        super().__init__()
        self.order = order

        self.b_net = nn.Sequential(
            nn.Linear(1, 32),
            nn.ReLU(),
            nn.Linear(32, order + 1)
        )

        self.a_net = nn.Sequential(
            nn.Linear(1, 32),
            nn.ReLU(),
            nn.Linear(32, order)
        )

    def forward(self, x):
        B, T = x.shape
        device = x.device

        y = torch.zeros_like(x)
        x_past = torch.zeros(B, self.order, device=device)
        y_past = torch.zeros(B, self.order, device=device)

        for t in range(T):
            t_norm = torch.full((B, 1), t / T, device=device)

            b = self.b_net(t_norm)
            a = torch.tanh(self.a_net(t_norm))  # stability constraint

            x_t = x[:, t].unsqueeze(1)

            ff = b[:, 0:1] * x_t
            for i in range(self.order):
                ff += b[:, i + 1:i + 2] * x_past[:, i:i + 1]

            fb = torch.zeros_like(ff)
            for i in range(self.order):
                fb += a[:, i:i + 1] * y_past[:, i:i + 1]

            y_t = ff - fb
            y[:, t] = y_t.squeeze(1)

            x_past = torch.cat([x_t, x_past[:, :-1]], dim=1)
            y_past = torch.cat([y_t, y_past[:, :-1]], dim=1)

        return y


class SpeechDenoiser(nn.Module):
    def __init__(self, order=2):
        super().__init__()
        self.filter = TimeVaryingIIR(order)

    def forward(self, x):
        return self.filter(x)


# =========================
# Generate Dummy Data
# =========================
torch.manual_seed(0)

T = 2000
t = torch.linspace(0, 1, T)

clean = torch.sin(2 * 3.14 * 5 * t)
noise = 0.5 * torch.randn(T)

noisy = clean + noise

clean = clean.unsqueeze(0)
noisy = noisy.unsqueeze(0)


# =========================
# Training Setup
# =========================
device = "cuda" if torch.cuda.is_available() else "cpu"

model = SpeechDenoiser(order=2).to(device)
optimizer = optim.Adam(model.parameters(), lr=1e-3)
criterion = nn.MSELoss()

noisy = noisy.to(device)
clean = clean.to(device)


# =========================
# Training Loop
# =========================
epochs = 20

for epoch in range(epochs):
    optimizer.zero_grad()

    output = model(noisy)
    loss = criterion(output, clean)

    loss.backward()
    optimizer.step()

    print(f"Epoch {epoch+1}, Loss: {loss.item():.6f}")


# =========================
# Visualization
# =========================
output = output.detach().cpu().squeeze()
noisy_plot = noisy.cpu().squeeze()
clean_plot = clean.cpu().squeeze()

plt.figure(figsize=(12, 6))
plt.plot(noisy_plot, label="Noisy Signal")
plt.plot(clean_plot, label="Clean Signal")
plt.plot(output, label="Denoised Output")
plt.legend()
plt.title("Speech Denoising using Time-Varying IIR Filter")
plt.show()


# =========================
# Save Model
# =========================
torch.save(model.state_dict(), "iir_denoiser.pth")
print("Model saved successfully!")
